---
import { AI_TARGETS } from "../lib/ai-targets";

interface Props {
  /** Content-collection id of the page, e.g. `guide/stow`. */
  slug: string;
}

const { slug } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const markdownPath = `${base}/${slug}.md`;
// AI assistants need a public URL, so use the production origin.
const markdownUrl = new URL(markdownPath, Astro.site ?? Astro.url).href;
const prompt = `Read ${markdownUrl} so I can ask questions about it.`;

const targets = AI_TARGETS.map((t) => ({ ...t, href: t.url(prompt) }));
---

<page-actions class="not-content" data-markdown-path={markdownPath}>
  <div class="split">
    <button type="button" class="copy" data-action="copy">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span data-label>Copy page</span>
    </button>
    <button
      type="button"
      class="toggle"
      aria-haspopup="menu"
      aria-expanded="false"
      aria-label="More page actions"
      data-action="toggle"
    >
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1 1 0 0 0 1.42 0L17 10.59a1 1 0 0 0 0-1.42Z"></path>
      </svg>
    </button>
  </div>

  <div class="menu" role="menu" hidden>
    <button type="button" role="menuitem" data-action="copy">
      <span class="icon">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </span>
      <span class="text">
        <strong>Copy page</strong>
        <small>Copy as Markdown for LLMs</small>
      </span>
    </button>
    <a role="menuitem" href={markdownPath} target="_blank" rel="noopener">
      <span class="icon">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <path d="M14 2v6h6M8 13h8M8 17h5"></path>
        </svg>
      </span>
      <span class="text">
        <strong>View as Markdown</strong>
        <small>View this page as plain text</small>
      </span>
      <span class="ext" aria-hidden="true">↗</span>
    </a>
    <hr />
    {
      targets.map((t) => (
        <a role="menuitem" href={t.href} target="_blank" rel="noopener noreferrer">
          <span class="icon">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d={t.icon} />
            </svg>
          </span>
          <span class="text">
            <strong>{t.label}</strong>
            <small>{t.description}</small>
          </span>
          <span class="ext" aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>
</page-actions>

<script>
  class PageActions extends HTMLElement {
    private menu!: HTMLElement;
    private toggle!: HTMLButtonElement;

    connectedCallback() {
      this.menu = this.querySelector(".menu") as HTMLElement;
      this.toggle = this.querySelector(".toggle") as HTMLButtonElement;

      this.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>(
          "[data-action]",
        );
        if (!target) return;
        if (target.dataset.action === "toggle") this.setOpen(this.menu.hidden);
        if (target.dataset.action === "copy") this.copy();
      });

      document.addEventListener("click", (event) => {
        if (!this.contains(event.target as Node)) this.setOpen(false);
      });
      this.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          this.setOpen(false);
          this.toggle.focus();
        }
      });
      this.menu.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) this.setOpen(false);
      });
    }

    private setOpen(open: boolean) {
      this.menu.hidden = !open;
      this.toggle.setAttribute("aria-expanded", String(open));
    }

    private async copy() {
      const labels = this.querySelectorAll<HTMLElement>("[data-label]");
      const flash = (text: string) => {
        for (const el of labels) {
          const original = el.dataset.label || el.textContent || "";
          el.dataset.label = original;
          el.textContent = text;
          setTimeout(() => {
            el.textContent = original;
          }, 1800);
        }
      };
      try {
        const res = await fetch(this.dataset.markdownPath as string);
        if (!res.ok) throw new Error(String(res.status));
        await navigator.clipboard.writeText(await res.text());
        flash("Copied!");
      } catch {
        flash("Copy failed");
      }
      this.setOpen(false);
    }
  }

  customElements.define("page-actions", PageActions);
</script>

<style>
  page-actions {
    position: relative;
    display: inline-block;
  }
  .split {
    display: inline-flex;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-bg-nav);
    overflow: hidden;
  }
  .split button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.7rem;
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-1);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .split button:hover,
  .split button[aria-expanded="true"] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
  .toggle {
    border-inline-start: 1px solid var(--sl-color-gray-5) !important;
    padding-inline: 0.4rem !important;
  }
  .toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.4rem);
    z-index: 20;
    width: min(20rem, calc(100vw - 2rem));
    padding: 0.35rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.8rem;
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-md);
  }
  .menu[hidden] {
    display: none;
  }
  .menu hr {
    margin: 0.35rem 0.25rem;
    border: 0;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .menu :is(a, button) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    padding: 0.5rem 0.55rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-1);
    font: inherit;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }
  .menu :is(a, button):hover,
  .menu :is(a, button):focus-visible {
    background: var(--sl-color-accent-low);
    outline: none;
  }
  .icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-white);
  }
  .text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
    line-height: 1.3;
  }
  .text strong {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .text small {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .ext {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
